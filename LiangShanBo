    def update_liang_follow(self):
        """Move Liang with delay so he follows Zhu but is not tied to Zhu."""
        if not self.player:
            return
        if not self.liang_follow.get("active", False):
            return
        if self.state not in (GameState.LEVEL_2, GameState.LEVEL_3):
            return

        follow_gap = 95 if self.player.facing > 0 else -95
        target_x = self.player.x - follow_gap
        target_y = self.player.y + self.player.height

        dx = target_x - self.liang_follow["x"]
        self.liang_follow["vx"] = self.liang_follow["vx"] * 0.82 + max(-1.7, min(1.7, dx * 0.045))
        self.liang_follow["x"] += self.liang_follow["vx"] * 4.0

        dy = target_y - self.liang_follow["y"]
        self.liang_follow["y"] += max(-3.0, min(3.0, dy * 0.2))

        # Keep a bit of distance to avoid overlap.
        if abs(self.liang_follow["x"] - self.player.x) < 34:
            if self.player.facing > 0:
                self.liang_follow["x"] = self.player.x - 34
            else:
                self.liang_follow["x"] = self.player.x + 34

        self.liang_follow["x"] = max(16.0, min(float(self.world_width - 16), self.liang_follow["x"]))
