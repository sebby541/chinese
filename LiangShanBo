            # Draw level name (Chinese only)
            level_data = LEVEL_PLATFORMS.get(self.state, {})
            level_name = level_data.get("name_zh", "")
            self.draw_text(level_name, self.font_medium, (139, 69, 19), 20, 20)
            story_prompt = self.level_story_prompts.get(self.state, "")
            if story_prompt:
                self.draw_text(story_prompt, self.font_small, (230, 220, 200), 24, 62)
            
            # Draw platforms (world -> screen via camera)
            for platform in self.current_platforms:
                draw_x = platform["x"] - self.camera_x
                # Skip drawing if off-screen
                if draw_x + platform["w"] < 0 or draw_x > 1280:
                    continue
                # Shadow
                shadow_rect = (draw_x + 4, platform["y"] + 6, platform["w"], platform["h"])
                pygame.draw.rect(self.screen, (120, 90, 60), shadow_rect)
                # Main platform
                plat_rect = (draw_x, platform["y"], platform["w"], platform["h"])
                pygame.draw.rect(self.screen, (205, 170, 110), plat_rect)
                # Top highlight line
                pygame.draw.line(self.screen, (255, 230, 180), (draw_x, platform["y"]), (draw_x + platform["w"], platform["y"]), 2)
                # Border
                pygame.draw.rect(self.screen, (120, 70, 30), plat_rect, 3)
            
            # Draw goal indicator (buildings serve as endpoints in background)
            gx = int(self.goal_x - self.camera_x)
            if self.state == GameState.LEVEL_6:
                # Heavenly portal - enhanced with multiple rings
                if -350 < gx < 1350:
                    # Pulsing glow effect
                    glow_scale = 1.0 + 0.2 * math.sin(self.anim_offset / 10)
                    glow_radius = int(150 * glow_scale)
                    glow_color = (255, 240 + int(15 * math.sin(self.anim_offset / 15)), 200)
                    pygame.draw.circle(self.screen, glow_color, (gx, 100), glow_radius, 2)
                    # Central bright point
                    pygame.draw.circle(self.screen, (255, 255, 255), (gx, 100), 15)
            
            # Draw player (world -> screen)
            if self.player:
                self.player.draw(self.screen, self.camera_x)

            # Liang follows Zhu during academy years and departure journey.
            self.draw_following_liang()
            
            # Draw message
            if self.message_timer > 0 and self.message:
                # Panel behind message for readability
                msg_surf = self.font_small.render(self.message, True, (200, 100, 50))
                msg_rect = msg_surf.get_rect(center=(640, 118))
                panel = pygame.Surface((msg_rect.width + 20, msg_rect.height + 12), pygame.SRCALPHA)
                panel.fill((10, 10, 10, 180))
                self.screen.blit(panel, (msg_rect.x - 10, msg_rect.y - 6))
                self.screen.blit(msg_surf, msg_rect)
            
            # Draw controls (Chinese only)
            if self.state == GameState.LEVEL_6:
                controls = "空格/W/↑ 上升 | A/D 或 ← → 飞行 | R 重试"
            elif self.state == GameState.LEVEL_5:
                controls = "A/D 或 ← → 步行 | R 重试"
            else:
                controls = "A/D 或 ← → 移动 | 空格/W/↑ 跳 | R 重试"
            self.draw_text(controls, self.font_small, (100, 100, 100), 10, 680)

            # Expanded instructions for the last level's flap physics and objective.
            if self.state == GameState.LEVEL_6:
                panel_x, panel_y, panel_w, panel_h = 828, 18, 434, 132
                panel = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)
                panel.fill((20, 16, 34, 178))
                self.screen.blit(panel, (panel_x, panel_y))
                pygame.draw.rect(self.screen, (255, 225, 170), (panel_x, panel_y, panel_w, panel_h), 2)
                self.draw_text("化蝶提示", self.font_small, (255, 232, 188), panel_x + 16, panel_y + 10)
                self.draw_text("1. 多按 空格/W/↑ 保持高度", self.font_small, (232, 220, 248), panel_x + 16, panel_y + 38)
                self.draw_text("2. 用 A/D 或 ← → 躲开柳枝", self.font_small, (232, 220, 248), panel_x + 16, panel_y + 66)
                self.draw_text("3. 飞进前方光圈就过关", self.font_small, (232, 220, 248), panel_x + 16, panel_y + 94)
        
        elif self.state in self.story_messages:
            # Story cutscene with background gradient
            for y in range(0, 720):
                shade = int(100 + (y / 720) * 50)
                pygame.draw.line(self.screen, (shade, shade - 20, 200), (0, y), (1280, y))
            
            # Decorative butterflies (skip in the dark reveal transition scene).
            if self.state != GameState.STORY_3C:
                butterfly_x1 = 100 + int(50 * self.anim_offset / 60)
                butterfly_x2 = 1180 - int(50 * self.anim_offset / 60)
                self.draw_butterfly(butterfly_x1, 100)
                self.draw_butterfly(butterfly_x2, 600)

            # Story character cameo: show Liang in chapters where he is central.
            if self.state == GameState.STORY_2:
                self.draw_story_disguise_student(470, ground_y=620)
                self.draw_liang_shanbo(320, ground_y=620, scale=1.18, pose="scholar")
            elif self.state == GameState.STORY_3:
                self.draw_eastern_jin_gatehouse(760, 438, 246, 182)
                self.draw_story_disguise_student(470, ground_y=620)
                self.draw_liang_shanbo(320, ground_y=620, scale=1.18, pose="scholar")
            elif self.state == GameState.STORY_3A:
                self.draw_story_zhu(470, ground_y=620, mood="calm")
                self.draw_liang_shanbo(320, ground_y=620, scale=1.18, pose="companion")
                self.draw_text_panel("再见", self.font_small, (255, 232, 198), 396, 498, bg=(30, 20, 32, 168), border=(236, 200, 162), pad_x=10, pad_y=4)
            elif self.state == GameState.STORY_3C:
                self.draw_liang_shanbo(350, ground_y=620, scale=1.18, pose="scholar")
                self.draw_story_zhu(940, ground_y=620, mood="calm")
                self.draw_text_panel("几个月后", self.font_small, (240, 232, 210), 640, 506, bg=(20, 18, 26, 185), border=(206, 186, 152), pad_x=12, pad_y=5)
                # Simple visual cue: Liang receives news and realizes the truth.
                letter_rect = pygame.Rect(414, 534, 44, 26)
                pygame.draw.rect(self.screen, (238, 228, 202), letter_rect)
                pygame.draw.rect(self.screen, (142, 124, 92), letter_rect, 2)
                pygame.draw.line(self.screen, (168, 144, 104), (letter_rect.left + 3, letter_rect.top + 4), (letter_rect.right - 3, letter_rect.bottom - 4), 1)
                self.draw_text("真相", self.font_small, (250, 214, 168), 930, 490, center=True)
            elif self.state == GameState.STORY_3B:
                self.draw_parent_figure(300, ground_y=620, gender="father")
                self.draw_story_zhu(470, ground_y=620, mood="argue")
                self.draw_parent_figure(640, ground_y=620, gender="mother")
                self.draw_text("!", self.font_medium, (255, 120, 120), 386, 510, center=True)
                self.draw_text("!", self.font_medium, (255, 120, 120), 556, 510, center=True)
            elif self.state == GameState.STORY_4:
                self.draw_story_zhu(520, ground_y=620, mood="calm")
                self.draw_liang_shanbo(320, ground_y=620, scale=1.2, pose="dead")
                self.draw_text_panel("山伯离世", self.font_small, (255, 224, 196), 392, 500, bg=(30, 20, 32, 170), border=(220, 186, 156), pad_x=10, pad_y=4)
            elif self.state == GameState.STORY_5:
                self.draw_liang_shanbo(300, ground_y=620, scale=1.2, pose="spirit")
            
            # Story messages (Chinese only)
            messages = self.story_messages[self.state].get("zh", [])
            top_y = 160
            line_gap = 72
            for idx, msg in enumerate(messages):
                self.draw_text(msg, self.font_medium, (255, 255, 255), 640, top_y + idx * line_gap, center=True)
            if self.state == GameState.STORY_3C:
                # Fade from black into the "months later" reveal.
                fade_frames = 45
                if self.story_scene_timer < fade_frames:
                    fade_alpha = int(255 * (1.0 - (self.story_scene_timer / float(fade_frames))))
                    fade_overlay = pygame.Surface((1280, 720), pygame.SRCALPHA)
                    fade_overlay.fill((0, 0, 0, max(0, min(255, fade_alpha))))
                    self.screen.blit(fade_overlay, (0, 0))
            self.draw_text("按空格继续", self.font_small, (255, 200, 100), 640, 672, center=True)
        
        elif self.state == GameState.ENDING:
            self.draw_ending_flappy()

            # Keep ending music active if state was switched directly
            if not self.ending_music_played:
                self.sound_manager.play_music("ending", loops=-1)
                self.ending_music_played = True
        
        pygame.display.flip()
    
    def draw_butterfly(self, x, y, scale=1.0, palette="gold", tilt=0.0):
        x = int(x)
        y = int(y)

        palettes = {
            "gold": {
                "wing_front": (255, 210, 90),
                "wing_back": (238, 170, 60),
                "body": (70, 50, 35),
                "spot": (255, 240, 180),
            },
            "rose": {
                "wing_front": (236, 126, 170),
                "wing_back": (178, 82, 126),
                "body": (72, 38, 28),
                "spot": (255, 186, 220),
            },
        }
        colors = palettes.get(palette, palettes["gold"])
        wing_offset = int((7 + 4 * abs(self.anim_offset - 30) / 30) * scale)
        wing_height = int(12 * scale)
        wing_low = int(8 * scale)
        body_h = int(18 * scale)
        body_w = max(4, int(5 * scale))
        tilt_px = int(max(-10, min(10, tilt / 4)))

        # Rear wings
        pygame.draw.polygon(
            self.screen,
            colors["wing_back"],
            [(x - 1, y - int(4 * scale)), (x - wing_offset - int(10 * scale), y - wing_height + tilt_px), (x - wing_offset - int(12 * scale), y + int(2 * scale))],
        )
        pygame.draw.polygon(
            self.screen,
            colors["wing_back"],
            [(x + 1, y - int(4 * scale)), (x + wing_offset + int(10 * scale), y - wing_height - tilt_px), (x + wing_offset + int(12 * scale), y + int(2 * scale))],
        )

        # Front lower wings
        pygame.draw.polygon(
            self.screen,
            colors["wing_front"],
            [(x - 1, y), (x - wing_offset - int(10 * scale), y + wing_low), (x - wing_offset - int(8 * scale), y + int(2 * scale))],
        )
        pygame.draw.polygon(
            self.screen,
            colors["wing_front"],
            [(x + 1, y), (x + wing_offset + int(10 * scale), y + wing_low), (x + wing_offset + int(8 * scale), y + int(2 * scale))],
        )

        # Body
        pygame.draw.ellipse(self.screen, colors["body"], (x - body_w // 2, y - body_h // 2, body_w, body_h))
        pygame.draw.circle(self.screen, colors["body"], (x, y - body_h // 2 - max(2, int(2 * scale))), max(2, int(3 * scale)))
        pygame.draw.line(self.screen, colors["body"], (x - 1, y - body_h // 2 - 2), (x - int(7 * scale), y - body_h // 2 - int(6 * scale)), 1)
        pygame.draw.line(self.screen, colors["body"], (x + 1, y - body_h // 2 - 2), (x + int(7 * scale), y - body_h // 2 - int(6 * scale)), 1)

        # Wing spots
        pygame.draw.circle(self.screen, colors["spot"], (x - wing_offset - int(4 * scale), y - int(4 * scale)), max(2, int(2 * scale)))
        pygame.draw.circle(self.screen, colors["spot"], (x + wing_offset + int(4 * scale), y - int(4 * scale)), max(2, int(2 * scale)))

