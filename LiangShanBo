            self.draw_volume_sliders()
            
            # Play title music on first render
            if not self.title_music_played:
                self.sound_manager.play_music("title")
                self.title_music_played = True
                self.ending_music_played = False
            
        elif self.state in PLAYABLE_LEVELS:
            # Draw background based on level
            if self.state == GameState.LEVEL_1:
                self.draw_background_level1()
            elif self.state == GameState.LEVEL_2:
                self.draw_background_level2()
            elif self.state == GameState.LEVEL_3:
                self.draw_background_level3()
            elif self.state == GameState.LEVEL_4:
                self.draw_background_level4()
            elif self.state == GameState.LEVEL_5:
                self.draw_background_level5()
