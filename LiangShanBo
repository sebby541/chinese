    def run(self):
        while self.running:
            # Compute delta-time (seconds) and store on the player so
            # Player methods can scale accelerations consistently.
            dt = self.clock.tick(60) / 1000.0
            if self.player:
                self.player._last_dt = dt

            self.handle_input()

            if self.player:
                self.player._last_dt = dt
            self.update()
            self.render()
        pygame.quit()

    def get_font(self, size):
        """Try to find a font that supports Chinese characters.
        Checks common system fonts first, then looks in assets/fonts.
        Falls back to default font if nothing found."""
        # macOS system font paths for CJK support
        macos_font_paths = [
            "/System/Library/Fonts/STHeiti Medium.ttc",
            "/System/Library/Fonts/STHeiti Light.ttc",
            "/System/Library/Fonts/Hiragino Sans GB.ttc",
            "/Library/Fonts/STHeiti Medium.ttc",
            "/Library/Fonts/STHeiti Light.ttc",
        ]
        
        # Try macOS system font paths first (most reliable)
        for path in macos_font_paths:
            try:
                if os.path.exists(path):
                    return pygame.font.Font(path, size)
            except Exception:
                continue
        
        # Fallback font candidates by name (SysFont)
        candidates = [
            "STHeiti", "ST Heiti", "PingFang SC", "Hiragino Sans GB",
            "Noto Sans CJK SC", "Noto Sans CJK", "SimHei",
            "Heiti SC", "Microsoft YaHei", "Arial Unicode MS"
        ]
        
        for name in candidates:
            try:
                path = pygame.font.match_font(name)
                if path:
                    return pygame.font.Font(path, size)
            except Exception:
                continue

        # Look for bundled fonts in assets/fonts
        try:
            base_dir = os.path.dirname(__file__)
        except NameError:
            base_dir = os.getcwd()
        fonts_dir = os.path.join(base_dir, "assets", "fonts")
        if os.path.isdir(fonts_dir):
            for fname in os.listdir(fonts_dir):
                if fname.lower().endswith((".ttf", ".ttc", ".otf")):
                    try:
                        return pygame.font.Font(os.path.join(fonts_dir, fname), size)
                    except Exception:
                        continue

        # Last resort: default font (may not render Chinese)
        try:
            return pygame.font.Font(None, size)
        except Exception:
            return pygame.font.SysFont(None, size)
    
    def handle_input(self):
        keys = pygame.key.get_pressed()
        mouse_pos = pygame.mouse.get_pos()
        
        # Jump key tracking for sound
        current_jump = keys[pygame.K_SPACE] or keys[pygame.K_w] or keys[pygame.K_UP]
        
        # Update volume sliders if being dragged
        if self.volume_slider_active:
            # Calculate percentage based on mouse X position
            slider_rect = self.music_slider_rect
            percent = max(0, min(1, (mouse_pos[0] - slider_rect.left) / slider_rect.width))
            self.sound_manager.set_music_volume(percent)
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            elif event.type == pygame.MOUSEBUTTONDOWN:
                # Handle volume slider clicks
                if event.button == 1:  # Left click
                    if self.music_slider_rect.collidepoint(mouse_pos):
                        self.volume_slider_active = "music"
                        # Update volume immediately on click
                        percent = max(0, min(1, (mouse_pos[0] - self.music_slider_rect.left) / self.music_slider_rect.width))
                        self.sound_manager.set_music_volume(percent)
            elif event.type == pygame.MOUSEBUTTONUP:
                if event.button == 1:
                    self.volume_slider_active = None
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_r:
                    if self.state == GameState.ENDING:
                        self.reset_ending_flappy()
                    else:
                        self.reset_level()
                elif event.key == pygame.K_SPACE:
                    if self.state == GameState.ENDING:
                        self.handle_ending_flap()
                    elif self.state == GameState.LEVEL_6:
                        # Space controls active lift in the final flight level.
                        self.sound_manager.play_sound("jump")
                    # Start from title
                    elif self.state == GameState.TITLE:
                        self.state = GameState.BACKSTORY
                        self.story_scene_timer = 0
                    # If the level is marked complete, advance on SPACE
                    elif self.level_complete and self.state in PLAYABLE_LEVELS:
                        self.advance_level()
                    # During story screens allow advancing
                    elif self.state in STORY_STATES:
                        self.advance_level()

                    # Play jump SFX when initiating a jump from ground
                    if self.player and self.player.on_ground and self.state in PLAYABLE_LEVELS and self.state not in (GameState.LEVEL_5, GameState.LEVEL_6):
                        self.sound_manager.play_sound("jump")
        
        # Player input for platformer levels
        if self.player and self.state in PLAYABLE_LEVELS:
            self.player.handle_input(keys)
            # play jump SFX when leaving ground (simple detection)
            if current_jump and self.player.on_ground and not self.jump_pressed and self.state not in (GameState.LEVEL_5, GameState.LEVEL_6):
                self.sound_manager.play_sound("jump")
                self.jump_pressed = True
            elif not current_jump:
                self.jump_pressed = False
    
    def start_level(self):
        level_key = self.state
        if level_key in LEVEL_PLATFORMS:
            level_data = LEVEL_PLATFORMS[level_key]
            self.current_platforms = level_data["platforms"]
            self.goal_x = level_data.get("goal_x", 1200)
            self.goal_y = level_data.get("goal_y", 600)
            start_x = level_data.get("start_x", 50)
            start_y = level_data.get("start_y", 560)
            
            # Level 6 is flying mode
            flying_mode = (level_key == GameState.LEVEL_6)
            outfit_mode_map = {
                GameState.LEVEL_1: "disguise",
                GameState.LEVEL_2: "disguise",
                GameState.LEVEL_3: "disguise",
                GameState.LEVEL_4: "liang_ill",
                GameState.LEVEL_5: "wedding_red",
                GameState.LEVEL_6: "revealed",
            }
            outfit_mode = outfit_mode_map.get(level_key, "disguise")
            jump_enabled = (level_key != GameState.LEVEL_5)
            self.player = Player(
                start_x,
                start_y,
                flying_mode=flying_mode,
                outfit_mode=outfit_mode,
                jump_enabled=jump_enabled,
            )

            # Liang follows during academy and departure levels.
            if level_key in (GameState.LEVEL_2, GameState.LEVEL_3):
                self.liang_follow["active"] = True
                self.liang_follow["x"] = float(max(20, start_x - 120))
                self.liang_follow["y"] = float(start_y + 40)
                self.liang_follow["vx"] = 0.0
            else:
                self.liang_follow["active"] = False
            
            # Load special flight obstacles when present (Level 6)
            self.current_willow_trees = level_data.get("willow_trees", [])
            
            self.level_complete = False
            self.level_complete_timer = 0
            self.message = ""
            self.message_timer = 0
            if level_key == GameState.LEVEL_5:
                self.message = "送亲路：只用左右走到墓前。"
                self.message_timer = 220
            elif level_key == GameState.LEVEL_4:
                self.pursuit_grief = 0
                self.message = "他一直追，但追不上。"
                self.message_timer = 180
            elif level_key == GameState.LEVEL_6:
                self.message = "化蝶：按空格上升，避开柳枝。"
                self.message_timer = 220
            
            # Play appropriate level music
            music_map = {
                GameState.LEVEL_1: "level_1",
                GameState.LEVEL_2: "level_2",
                GameState.LEVEL_3: "level_3",
                GameState.LEVEL_4: "level_4",
                GameState.LEVEL_5: "level_5",
                GameState.LEVEL_6: "level_6"
            }
            if level_key in music_map:
                self.sound_manager.play_music(music_map[level_key], loops=-1)  # Loop music continuously
            # calculate world width from platforms and goal
            max_x = self.goal_x
            for p in self.current_platforms:
                max_x = max(max_x, p.get("x", 0) + p.get("w", 0))
            # For flying mode, also consider willow tree positions
            for tree in self.current_willow_trees:
                max_x = max(max_x, tree.get("x", 0) + tree.get("w", 0))
            self.world_width = max(1280, max_x + 200)
            # reset camera
            self.camera_x = 0
    
    def reset_level(self):
        if self.state in LEVEL_PLATFORMS:
            self.start_level()
        elif self.state == GameState.ENDING:
            self.reset_ending_flappy()
    
    def update(self):
        self.anim_offset = (self.anim_offset + 1) % 60
        self.message_timer = max(0, self.message_timer - 1)
        if self.state in STORY_STATES:
            self.story_scene_timer += 1
        else:
            self.story_scene_timer = 0
        
        # Update platformer level
        if self.player and self.state in PLAYABLE_LEVELS:
            if self.level_complete:
                if self.level_complete_timer > 0:
                    self.level_complete_timer -= 1
                if self.level_complete_timer == 0:
                    self.advance_level()
                return

            if not self.player.update(self.current_platforms, getattr(self, 'current_willow_trees', [])):
                self.sound_manager.play_sound("heartbreak")
                self.reset_level()
                self.message = "掉下去了，按 R 重试。"
                self.message_timer = 120
                return

            self.update_liang_follow()

            # Level 4 is intentionally unwinnable: grief builds until Liang collapses.
            if self.state == GameState.LEVEL_4 and not self.level_complete:
                self.pursuit_grief += 1
                progress = self.player.x / max(1, self.goal_x)
                self.pursuit_grief = max(self.pursuit_grief, int(progress * 760))
                if self.pursuit_grief > 360 and self.message_timer == 0:
                    self.message = "他追不动了……"
                    self.message_timer = 90
                if self.pursuit_grief > 700 or self.player.x >= self.goal_x - 260:
                    self.level_complete = True
                    self.level_complete_timer = 130
                    self.message = "梁山伯心碎倒下。"
                    self.message_timer = 130
            
            # Check if reached goal (special handling for grave leap and butterfly ascent)
            player_rect = pygame.Rect(self.player.x, self.player.y, self.player.width, self.player.height)
            if self.state != GameState.LEVEL_4:
                if self.state == GameState.LEVEL_6:
                    # For Level 6, goal is in the heavens (above screen)
                    goal_rect = pygame.Rect(self.goal_x - 80, self.goal_y - 80, 160, 160)
                elif self.state == GameState.LEVEL_5:
                    # For Level 5, goal is leaping into the opened grave
                    goal_rect = pygame.Rect(self.goal_x - 70, self.goal_y - 40, 140, 140)
                else:
                    goal_rect = pygame.Rect(self.goal_x - 20, self.goal_y - 20, 40, 100)
                if player_rect.colliderect(goal_rect):
                    if not self.level_complete:
                        self.level_complete = True
                        self.level_complete_timer = 120
                        self.sound_manager.play_sound("goal")
                        self.message = self.level_complete_messages.get(self.state, "过关了，按空格继续。")
                        self.message_timer = 140
            # Update camera to follow player (centered) with vertical focus
            # For Level 6, emphasize vertical movement
            target_cam = int(self.player.x - (1280 // 2))
            if self.state == GameState.LEVEL_6:
                # Center on player more aggressively
                target_cam = max(0, int(self.player.x - 640))
            max_cam = max(0, self.world_width - 1280)
            self.camera_x = max(0, min(target_cam, max_cam))
        elif self.state == GameState.ENDING:
            self.update_ending_flappy()
    
    def advance_level(self):
        state_order = [
            GameState.BACKSTORY,
            GameState.LEVEL_1, GameState.STORY_1,
            GameState.LEVEL_2, GameState.STORY_2,
            GameState.LEVEL_3, GameState.STORY_3, GameState.STORY_3A, GameState.STORY_3C, GameState.STORY_3B,
            GameState.LEVEL_4, GameState.STORY_4,
            GameState.LEVEL_5, GameState.STORY_5,
            GameState.LEVEL_6, GameState.ENDING
        ]
        
        # Music mapping for story cutscenes (each story uses corresponding level's music)
        story_music_map = {
            GameState.BACKSTORY: "title",
            GameState.STORY_1: "level_1",
            GameState.STORY_2: "level_2",
            GameState.STORY_3: "level_3",
            GameState.STORY_3A: "level_3",
            GameState.STORY_3C: "level_3",
            GameState.STORY_3B: "level_4",
            GameState.STORY_4: "level_4",
            GameState.STORY_5: "level_5"
        }
        
        try:
            current_idx = state_order.index(self.state)
            if current_idx < len(state_order) - 1:
                self.state = state_order[current_idx + 1]
                self.story_scene_timer = 0
                if self.state in PLAYABLE_LEVELS:
                    self.start_level()
                    self.ending_music_played = False
                elif self.state in STORY_STATES:
                    # Play appropriate music for story segment
                    if self.state in story_music_map:
                        self.sound_manager.play_music(story_music_map[self.state])
                elif self.state == GameState.ENDING:
                    self.player = None
                    self.camera_x = 0
                    self.world_width = 1280
                    self.reset_ending_flappy()
                    self.sound_manager.play_music("ending", loops=-1)
                    self.ending_music_played = True
        except ValueError:
            pass
    
