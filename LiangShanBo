class Player(pygame.sprite.Sprite):
    def __init__(self, x, y, flying_mode=False, outfit_mode="disguise", jump_enabled=True):
        super().__init__()
        self.x = x
        self.y = y
        self.width = 30
        self.height = 40
        self.vel_x = 0
        self.vel_y = 0
        self.on_ground = False
        self.flying_mode = flying_mode  # True for Level 6 flying mechanic
        self.outfit_mode = outfit_mode  # "disguise"/"revealed"/"wedding_red"/"liang_ill"
        self.jump_enabled = jump_enabled
        self.gravity = 0.7
        self.jump_power = -13
        # Smooth movement variables
        self.speed = 5
        self.max_speed = 7
        # Movement tuning for more fluid control
        self.accel = 0.9
        self.ground_accel = 1.0    # per-frame horizontal acceleration on ground (tuned)
        self.air_accel = 0.35      # per-frame horizontal acceleration in air (tuned)
        self.ground_friction = 0.7 # stronger friction when stopping on ground (tuned)
        self.brake_factor = 0.35   # instant braking when reversing direction (snappier)
        self.friction = 0.9
        # coyote time for forgiving jumps (frames)
        self.coyote_time_max = 8
        self.coyote_timer = 0
        # jump buffer
        self.jump_buffer_max = 6
        self.jump_buffer = 0
        # variable jump (cut jump short on release)
        self.holding_jump = False
        self.jump_cut_multiplier = 0.45
        # Flying mode constants (Level 6)
        self.flying_horizontal_speed = 8  # max horizontal speed when flying
        self.flying_gravity = 0.42
        self.flying_lift_accel = 1.05
        self.flying_max_rise = -7.5
        self.flying_max_fall = 7.5
        # Sprite animation helpers
        self.facing = 1
        self.step_phase = 0.0
    
    def handle_input(self, keys):
        # In flying mode, player can control horizontal movement
        if self.flying_mode:
            target_vx = 0
            if keys[pygame.K_a] or keys[pygame.K_LEFT]:
                target_vx = -self.flying_horizontal_speed
            if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
                target_vx = self.flying_horizontal_speed
            if target_vx != 0:
                self.facing = 1 if target_vx > 0 else -1

            dt = getattr(self, '_last_dt', 1/60)
            dt_scale = dt * 60.0

            # Smooth acceleration for flying
            accel_amount = 0.8 * dt_scale
            diff = target_vx - self.vel_x
            if diff > 0:
                self.vel_x += min(diff, accel_amount)
            elif diff < 0:
                self.vel_x += max(diff, -accel_amount)

            # Clamp horizontal speed
            if self.vel_x > self.flying_horizontal_speed:
                self.vel_x = self.flying_horizontal_speed
            if self.vel_x < -self.flying_horizontal_speed:
                self.vel_x = -self.flying_horizontal_speed

            # Space/W/Up gives lift; otherwise gravity in update pulls down.
            fly_pressed = keys[pygame.K_SPACE] or keys[pygame.K_w] or keys[pygame.K_UP]
            if fly_pressed:
                self.vel_y -= self.flying_lift_accel * dt_scale
                if self.vel_y < self.flying_max_rise:
                    self.vel_y = self.flying_max_rise
            return
        
        # Normal platformer mode (Level 1-4)
        # Determine desired horizontal direction
        target_vx = 0
        if keys[pygame.K_a] or keys[pygame.K_LEFT]:
            target_vx = -self.max_speed
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
            target_vx = self.max_speed
        if target_vx != 0:
            self.facing = 1 if target_vx > 0 else -1

        # Read last frame dt (seconds) stored by Game before calling input
        dt = getattr(self, '_last_dt', 1/60)
        dt_scale = dt * 60.0

        # Smooth, responsive acceleration: different in air vs ground
        accel_amount = (self.ground_accel if self.on_ground else self.air_accel) * dt_scale
        diff = target_vx - self.vel_x
        if diff > 0:
            self.vel_x += min(diff, accel_amount)
        elif diff < 0:
            self.vel_x += max(diff, -accel_amount)

        # Strong braking when reversing direction on ground (scale with dt)
        if self.on_ground and target_vx != 0 and (self.vel_x * target_vx) < 0:
            self.vel_x *= (self.brake_factor ** dt_scale)

        # Apply friction when no input (ground only) using exponential decay
        if target_vx == 0 and self.on_ground:
            self.vel_x *= (self.ground_friction ** dt_scale)

        # clamp horizontal speed
        if self.vel_x > self.max_speed:
            self.vel_x = self.max_speed
        if self.vel_x < -self.max_speed:
            self.vel_x = -self.max_speed

        # Jump buffering and hold detection (for variable jump height)
        if self.jump_enabled:
            wants_jump = keys[pygame.K_SPACE] or keys[pygame.K_w] or keys[pygame.K_UP]
            if wants_jump:
                self.jump_buffer = self.jump_buffer_max
                self.holding_jump = True
            else:
                # Decrement buffer in dt-scaled "frames" so buffer time remains
                # consistent across variable frame rates.
                self.jump_buffer = max(0, self.jump_buffer - dt_scale)
                self.holding_jump = False
        else:
            self.jump_buffer = 0
            self.holding_jump = False
    
    def update(self, platforms, willow_trees=None):
        # Read last frame dt (seconds)
        dt = getattr(self, '_last_dt', 1/60)
        dt_scale = dt * 60.0

        # Flying mode uses separate gravity/lift physics.
        if self.flying_mode:
            self.vel_y += self.flying_gravity * dt_scale
            if self.vel_y > self.flying_max_fall:
                self.vel_y = self.flying_max_fall
        else:
            # Apply gravity scaled to keep feel consistent across frame rates
            self.vel_y += self.gravity * dt_scale

        # Update position (velocities are in per-frame-equivalent units)
        self.x += self.vel_x
        self.y += self.vel_y
        
        # Collision detection
        # Update coyote timer
        if self.on_ground:
            self.coyote_timer = self.coyote_time_max
        else:
            self.coyote_timer = max(0, self.coyote_timer - dt_scale)

        self.on_ground = False
        player_rect = pygame.Rect(self.x, self.y, self.width, self.height)
        
        # Handle willow tree collisions for flying mode
        if self.flying_mode and willow_trees:
            for tree in willow_trees:
                tree_rect = pygame.Rect(tree["x"], tree["y"], tree["w"], tree["h"])
                if player_rect.colliderect(tree_rect):
                    # Bounce player away from tree (left or right depending on collision side)
                    if player_rect.centerx < tree_rect.centerx:
                        # Tree is to the right, push player left
                        self.x = tree_rect.left - self.width - 5
                        self.vel_x = -2
                    else:
                        # Tree is to the left, push player right
                        self.x = tree_rect.right + 5
                        self.vel_x = 2
        
        # Handle platform collisions for platformer mode
        for platform in platforms:
            plat_rect = pygame.Rect(platform["x"], platform["y"], platform["w"], platform["h"])
            if player_rect.colliderect(plat_rect):
                # Landing on platform from above
                if self.vel_y > 0 and player_rect.bottom >= plat_rect.top and player_rect.centery < plat_rect.centery:
                    self.y = plat_rect.top - self.height
                    self.vel_y = 0
                    self.on_ground = True
                    self.coyote_timer = self.coyote_time_max

        # Handle buffered jump (if buffer present and coyote time allows) - platformer only
        if not self.flying_mode:
            if self.jump_buffer > 0 and self.coyote_timer > 0:
                # Apply jump impulse scaled similarly to per-frame tuning
                self.vel_y = self.jump_power * dt_scale
                self.on_ground = False
                self.jump_buffer = 0
                self.coyote_timer = 0
            # Variable jump: if player released jump early while moving upward,
            # reduce upward velocity so jumps feel snappier and more controllable.
            if not self.holding_jump and self.vel_y < 0:
                self.vel_y *= self.jump_cut_multiplier
            # Lightweight walk animation state for sprite polish
            if self.on_ground and abs(self.vel_x) > 0.25:
                self.step_phase = (self.step_phase + 0.32 * dt_scale) % (math.tau)
            else:
                self.step_phase *= 0.8
        
        # Left screen/world boundary
        if self.x < 0:
            self.x = 0

        # Keep flyer in the visible sky instead of drifting off-screen.
        if self.flying_mode and self.y < 0:
            self.y = 0
            self.vel_y = max(0, self.vel_y)
        
        # Fall off screen (or reach goal)
        if self.y > 720:
            return False
        return True
    
