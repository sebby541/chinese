    def reset_ending_flappy(self):
        self.ending_state = "intro"
        self.ending_butterfly_y = 360.0
        self.ending_butterfly_vel = 0.0
        self.ending_butterfly_tilt = -6.0
        self.ending_scroll = 0.0
        self.ending_obstacles = []
        self.ending_spawn_timer = 45
        self.ending_score = 0
        self.ending_retry_cooldown = 0

    def handle_ending_flap(self):
        if self.ending_state == "complete":
            self.state = GameState.TITLE
            self.title_music_played = False
            self.ending_music_played = False
            self.player = None
            self.sound_manager.play_music("title", loops=-1)
            return

        if self.ending_state in ["intro", "crashed"]:
            self.ending_state = "playing"
            self.ending_butterfly_y = 360.0
            self.ending_butterfly_vel = -7.0
            self.ending_butterfly_tilt = -28.0
            self.ending_obstacles = []
            self.ending_spawn_timer = 30
            self.ending_score = 0
            self.ending_scroll = 0.0
            self.sound_manager.play_sound("jump")
            return

        if self.ending_state == "playing":
            self.ending_butterfly_vel = -7.4
            self.ending_butterfly_tilt = -30.0
            self.sound_manager.play_sound("jump")

    def spawn_ending_obstacle(self):
        gap_h = random.randint(190, 230)
        gap_top = random.randint(95, 720 - gap_h - 95)
        width = random.randint(90, 108)
        self.ending_obstacles.append({
            "x": 1320.0,
            "w": width,
            "gap_y": gap_top,
            "gap_h": gap_h,
            "passed": False,
        })

    def update_ending_flappy(self):
        self.ending_retry_cooldown = max(0, self.ending_retry_cooldown - 1)
        self.ending_scroll = (self.ending_scroll + 2.4) % 2000

        if self.ending_state == "intro":
            self.ending_butterfly_y = 360.0 + 7.0 * math.sin(pygame.time.get_ticks() / 180.0)
            self.ending_butterfly_vel = 0.0
            self.ending_butterfly_tilt = -6.0
            return

        if self.ending_state == "complete":
            self.ending_butterfly_y = 310.0 + 12.0 * math.sin(pygame.time.get_ticks() / 220.0)
            self.ending_butterfly_vel *= 0.85
            self.ending_butterfly_tilt = -8.0
            return

        if self.ending_state == "crashed":
            self.ending_butterfly_vel = min(10.0, self.ending_butterfly_vel + 0.5)
            self.ending_butterfly_y = min(702.0, self.ending_butterfly_y + self.ending_butterfly_vel)
            self.ending_butterfly_tilt = min(65.0, self.ending_butterfly_tilt + 3.5)
            for obstacle in self.ending_obstacles:
                obstacle["x"] -= 2.8
            self.ending_obstacles = [o for o in self.ending_obstacles if o["x"] + o["w"] > -80]
            return

        # Playing state
        self.ending_butterfly_vel = min(9.5, self.ending_butterfly_vel + 0.42)
        self.ending_butterfly_y += self.ending_butterfly_vel
        self.ending_butterfly_tilt = max(-35.0, min(55.0, self.ending_butterfly_vel * 4.0))
        self.ending_spawn_timer -= 1
        if self.ending_spawn_timer <= 0:
            self.spawn_ending_obstacle()
            self.ending_spawn_timer = 88

        butterfly_rect = pygame.Rect(self.ending_butterfly_x - 15, int(self.ending_butterfly_y) - 13, 30, 26)
        for obstacle in self.ending_obstacles:
            obstacle["x"] -= 4.6
            top_rect = pygame.Rect(int(obstacle["x"]), 0, obstacle["w"], obstacle["gap_y"])
            gap_bottom = obstacle["gap_y"] + obstacle["gap_h"]
            bottom_rect = pygame.Rect(int(obstacle["x"]), gap_bottom, obstacle["w"], 720 - gap_bottom)
            if butterfly_rect.colliderect(top_rect) or butterfly_rect.colliderect(bottom_rect):
                self.ending_state = "crashed"
                self.ending_retry_cooldown = 10
                self.sound_manager.play_sound("heartbreak")
                break
            if not obstacle["passed"] and obstacle["x"] + obstacle["w"] < self.ending_butterfly_x:
                obstacle["passed"] = True
                self.ending_score += 1
                self.sound_manager.play_sound("goal")
                if self.ending_score >= self.ending_target_score:
                    self.ending_state = "complete"
                    self.ending_obstacles = []
                    self.ending_butterfly_vel = -1.2
                    self.sound_manager.play_sound("goal")
                    break

        self.ending_obstacles = [o for o in self.ending_obstacles if o["x"] + o["w"] > -80]
        if self.ending_state == "playing" and (self.ending_butterfly_y < 12 or self.ending_butterfly_y > 708):
            self.ending_state = "crashed"
            self.ending_retry_cooldown = 10
            self.sound_manager.play_sound("heartbreak")

