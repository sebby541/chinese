        foundation_y = y + h - 2
        foundation_h = max(14, min(28, h // 6))
        pygame.draw.ellipse(self.screen, (112, 98, 80), (x - 26, foundation_y - 10, w + 52, foundation_h + 16))
        pygame.draw.rect(self.screen, (132, 118, 98), (x - 20, foundation_y - 2, w + 40, foundation_h))
