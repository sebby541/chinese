class Player(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.x = x
        self.y = y
        self.width = 30
        self.height = 40
        self.vel_x = 0
        self.vel_y = 0
        self.on_ground = False
        self.gravity = 0.7
        self.jump_power = -13
        # Smooth movement variables
        self.speed = 5
        self.max_speed = 7
        # Movement tuning for more fluid control
        self.accel = 0.9
        self.ground_accel = 1.0    # per-frame horizontal acceleration on ground (tuned)
        self.air_accel = 0.35      # per-frame horizontal acceleration in air (tuned)
        self.ground_friction = 0.7 # stronger friction when stopping on ground (tuned)
        self.brake_factor = 0.35   # instant braking when reversing direction (snappier)
        self.friction = 0.9
        # coyote time for forgiving jumps (frames)
        self.coyote_time_max = 8
        self.coyote_timer = 0
        # jump buffer
        self.jump_buffer_max = 6
        self.jump_buffer = 0
        # variable jump (cut jump short on release)
        self.holding_jump = False
        self.jump_cut_multiplier = 0.45
    
    def handle_input(self, keys):
        # Determine desired horizontal direction
        target_vx = 0
        if keys[pygame.K_a] or keys[pygame.K_LEFT]:
            target_vx = -self.max_speed
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
            target_vx = self.max_speed

        # Smooth, responsive acceleration: different in air vs ground
        accel_amount = self.ground_accel if self.on_ground else self.air_accel
        # compute change needed
        diff = target_vx - self.vel_x
        # apply acceleration toward target, clamped by accel_amount
        if diff > 0:
            self.vel_x += min(diff, accel_amount)
        elif diff < 0:
            self.vel_x += max(diff, -accel_amount)

        # Strong braking when reversing direction on ground
        if self.on_ground and target_vx != 0 and (self.vel_x * target_vx) < 0:
            self.vel_x *= self.brake_factor

        # Apply friction when no input (ground only)
        if target_vx == 0 and self.on_ground:
            self.vel_x *= self.ground_friction

        # clamp horizontal speed
        if self.vel_x > self.max_speed:
            self.vel_x = self.max_speed
        if self.vel_x < -self.max_speed:
            self.vel_x = -self.max_speed

        # Jump buffering and hold detection (for variable jump height)
        wants_jump = keys[pygame.K_SPACE] or keys[pygame.K_w] or keys[pygame.K_UP]
        if wants_jump:
            self.jump_buffer = self.jump_buffer_max
            self.holding_jump = True
        else:
            self.jump_buffer = max(0, self.jump_buffer - 1)
            self.holding_jump = False
    
    def update(self, platforms):
        # Apply gravity
        self.vel_y += self.gravity
        
        # Update position
        self.x += self.vel_x
        self.y += self.vel_y
        
        # Collision detection
        # Update coyote timer
        if self.on_ground:
            self.coyote_timer = self.coyote_time_max
        else:
            self.coyote_timer = max(0, self.coyote_timer - 1)

        self.on_ground = False
        player_rect = pygame.Rect(self.x, self.y, self.width, self.height)
        
        for platform in platforms:
            plat_rect = pygame.Rect(platform["x"], platform["y"], platform["w"], platform["h"])
            if player_rect.colliderect(plat_rect):
                # Landing on platform from above
                if self.vel_y > 0 and player_rect.bottom >= plat_rect.top and player_rect.centery < plat_rect.centery:
                    self.y = plat_rect.top - self.height
                    self.vel_y = 0
                    self.on_ground = True
                    self.coyote_timer = self.coyote_time_max

        # Handle buffered jump (if buffer present and coyote time allows)
        if self.jump_buffer > 0 and self.coyote_timer > 0:
            self.vel_y = self.jump_power
            self.on_ground = False
            self.jump_buffer = 0
            self.coyote_timer = 0
        # Variable jump: if player released jump early while moving upward,
        # reduce upward velocity so jumps feel snappier and more controllable.
        if not self.holding_jump and self.vel_y < 0:
            self.vel_y *= self.jump_cut_multiplier
        
        # Left screen/world boundary
        if self.x < 0:
            self.x = 0
        
        # Fall off screen
        if self.y > 720:
            return False
        return True
    
    def draw(self, screen, camera_x=0):
        """Draw detailed character sprite"""
        # Basic screen offset support: if a camera is applied the caller
        # should pass a `camera_x` argument into draw(). For backward
        # compatibility we default to 0 and compute draw_x accordingly.
        draw_x = camera_x
        # main body (robe) with more detail: sash, collar, and shading
        body_x = int(self.x - draw_x)
        body_y = int(self.y)
        # small lean based on horizontal velocity for visual feedback
        lean = int(max(-6, min(6, -self.vel_x * 1.8)))
        # Robe base
        pygame.draw.rect(screen, (100, 150, 200), (body_x + 5, body_y + 10, 20, 25), 0)
        # Sash (shifted by lean)
        pygame.draw.rect(screen, (180, 50, 80), (body_x + 8 + lean, body_y + 18, 14, 6), 0)
        # Collar (shifted by lean)
        pygame.draw.polygon(screen, (220, 180, 160), [(body_x + 8 + lean, body_y + 10), (body_x + 15 + lean, body_y + 2), (body_x + 22 + lean, body_y + 10)])
        # Head with simple hair (shifted by lean)
        pygame.draw.circle(screen, (220, 180, 160), (body_x + 15 + lean, body_y + 5), 6)
        pygame.draw.arc(screen, (40, 30, 20), (body_x + 9 + lean, body_y - 3, 12, 10), 3.14, 6.28, 2)
        # Eyes and subtle smile
        pygame.draw.circle(screen, (0, 0, 0), (body_x + 13 + lean, body_y + 3), 2)
        pygame.draw.circle(screen, (0, 0, 0), (body_x + 17 + lean, body_y + 3), 2)
        pygame.draw.arc(screen, (0, 0, 0), (body_x + 11 + lean, body_y + 4, 8, 6), 3.14, 0, 1)
        # Arms with slight shading
        pygame.draw.line(screen, (220, 180, 160), (body_x + 5 + lean, body_y + 15), (body_x + lean, body_y + 12), 3)
        pygame.draw.line(screen, (220, 180, 160), (body_x + 25 + lean, body_y + 15), (body_x + 30 + lean, body_y + 12), 3)
        # Legs / shoes
        pygame.draw.line(screen, (50, 50, 50), (body_x + 10, body_y + 35), (body_x + 10, body_y + 42), 4)
        pygame.draw.line(screen, (50, 50, 50), (body_x + 20, body_y + 35), (body_x + 20, body_y + 42), 4)
        # Outline
        pygame.draw.rect(screen, (0, 0, 0), (body_x, body_y, self.width, self.height), 2)

