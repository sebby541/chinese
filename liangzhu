class SoundManager:
    """Manages all game music and sound effects"""
    def __init__(self):
        pygame.mixer.init()
        self.current_music = None
        self.sounds = {}
        self.music_volume = 0.7
        self.sfx_volume = 0.5
        self.load_sounds()
    
    def load_sounds(self):
        """Load sound effects (non-music audio)"""
        sfx_files = ["jump", "goal", "heartbreak"]
        for sfx in sfx_files:
            try:
                key = AUDIO_PATHS.get(sfx, "")
                if key and os.path.exists(key):
                    self.sounds[sfx] = pygame.mixer.Sound(key)
                    self.sounds[sfx].set_volume(self.sfx_volume)
            except:
                pass  # Skip if file doesn't exist
    
    def play_music(self, music_key, loops=-1):
        """Play background music"""
        if not music_key in AUDIO_PATHS:
            return
        
        path = AUDIO_PATHS[music_key]
        if not os.path.exists(path):
            return
        
        try:
            if self.current_music != music_key:
                pygame.mixer.music.load(path)
                pygame.mixer.music.set_volume(self.music_volume)
                pygame.mixer.music.play(loops)
                self.current_music = music_key
        except:
            pass
    
    def play_sound(self, sfx_key):
        """Play sound effect"""
        if sfx_key in self.sounds:
            self.sounds[sfx_key].play()
    
    def stop_music(self):
        """Stop background music"""
        pygame.mixer.music.stop()
        self.current_music = None



